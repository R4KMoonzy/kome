rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function ownsBusiness(id) {
      return request.auth != null
        && id != null
        && exists(/databases/$(database)/documents/businesses/$(id))
        && get(/databases/$(database)/documents/businesses/$(id)).data.ownerId == request.auth.uid;
    }

    match /app_config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /businesses/{id} {
      allow read: if true;
      allow create: if isAdmin()
        || (request.auth != null && request.resource.data.ownerId == request.auth.uid);
      allow update: if isAdmin()
        || (request.auth != null
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if isAdmin();
    }

    match /business_requests/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.ownerId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /promotions/{id} {
      allow read: if true;
      allow create: if isAdmin() || ownsBusiness(request.resource.data.businessId);
      allow update, delete: if isAdmin() || ownsBusiness(resource.data.businessId);
    }

    match /reviews/{id} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    match /messages/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || isSelf(userId);
      allow create: if isSelf(userId) && request.resource.data.role == 'usuario';
      allow update: if isAdmin()
        || (isSelf(userId)
          && request.resource.data.role == 'usuario'
          && resource.data.role == 'usuario');
      allow delete: if false;

      match /favorites/{favId} {
        allow read, write: if isSelf(userId);
      }
    }
  }
}
